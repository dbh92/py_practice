# Python virtual environment (recreate with: python -m venv .venv && pip install -r requirements.txt)
.venv/

# Python bytecode cache
__pycache__/
*.pyc

# PyCharm per-user window state
.idea/workspace.xml

# Service logs and saved images (generated while the service runs)
service/logs/

# C# build output (rebuild with: dotnet build inspection_app -c Release)
inspection_app/bin/
inspection_app/obj/
.vs/
