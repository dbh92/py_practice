<!-- Cửa sổ chính: trên cùng là kết nối service, giữa là ảnh (trái) + kết quả (phải), dưới cùng là lịch sử kiểm tra -->
<Window x:Class="InspectionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiểm tra OK/NG" Height="820" Width="1300" MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen" FontSize="14"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.Resources>
        <!-- Nút: có khoảng đệm cho dễ bấm -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <!-- Nhãn bên trái của bảng chi tiết -->
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,3,12,3"/>
        </Style>
        <!-- Giá trị bên phải của bảng chi tiết -->
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Con số thống kê -->
        <Style x:Key="CountText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <!-- Chữ dưới con số thống kê -->
        <Style x:Key="CountLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===== Thanh trên cùng: địa chỉ service, trạng thái kết nối, mã trạm, mã sản phẩm ===== -->
        <Border DockPanel.Dock="Top" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Service:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="UrlBox" Width="210" Text="http://127.0.0.1:8000" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="ConnectButton" Content="Kết nối" Click="ConnectButton_Click"/>
                    <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="Gray" VerticalAlignment="Center" Margin="4,0,6,0"/>
                    <TextBlock x:Name="StatusText" Text="Chưa kết nối" VerticalAlignment="Center" Margin="0,0,14,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="Trạm:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                    <TextBox x:Name="StationBox" Width="90" Text="ST01" VerticalContentAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="Mã SP / Lô:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="ProductBox" Width="160" VerticalContentAlignment="Center"/>
                </StackPanel>
                <!-- Thông tin mô hình: chiếm phần còn lại, quá dài thì hiện "..." -->
                <TextBlock x:Name="ModelText" Foreground="#4B5563" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ===== Phần dưới cùng: lịch sử kiểm tra ===== -->
        <DockPanel DockPanel.Dock="Bottom" Height="230" Margin="12,0,12,12">
            <DockPanel DockPanel.Dock="Top" Margin="0,10,0,6">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Xuất CSV..." Click="ExportButton_Click"/>
                    <Button Content="Xóa lịch sử" Click="ClearButton_Click" Margin="0"/>
                </StackPanel>
                <TextBlock Text="Lịch sử kiểm tra (mới nhất ở trên, bấm vào một dòng để xem lại)" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E5E7EB" SelectionChanged="HistoryGrid_SelectionChanged">
                <!-- Tô màu dòng theo kết quả -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Result}" Value="OK">
                                <Setter Property="Background" Value="#E8F5E9"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Result}" Value="NG">
                                <Setter Property="Background" Value="#FFEBEE"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Result}" Value="HOLD">
                                <Setter Property="Background" Value="#FFF3E0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Thời gian" Binding="{Binding TimeText}" Width="100"/>
                    <DataGridTextColumn Header="Kết quả" Binding="{Binding Result}" Width="70" FontWeight="Bold"/>
                    <DataGridTextColumn Header="P(NG)" Binding="{Binding PNgText}" Width="80"/>
                    <DataGridTextColumn Header="Service (ms)" Binding="{Binding ServiceMsText}" Width="95"/>
                    <DataGridTextColumn Header="Khứ hồi (ms)" Binding="{Binding RoundTripMsText}" Width="100"/>
                    <DataGridTextColumn Header="Trạm" Binding="{Binding StationId}" Width="70"/>
                    <DataGridTextColumn Header="Mã SP / Lô" Binding="{Binding ProductId}" Width="110"/>
                    <DataGridTextColumn Header="File ảnh" Binding="{Binding FileName}" Width="*"/>
                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding Error}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- ===== Phần giữa: ảnh bên trái, kết quả bên phải ===== -->
        <Grid Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Bên trái: các nút chọn ảnh và khung xem ảnh -->
            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button x:Name="OpenFilesButton" Content="Chọn ảnh..." Click="OpenFilesButton_Click"/>
                    <Button x:Name="OpenFolderButton" Content="Kiểm tra cả thư mục..." Click="OpenFolderButton_Click"/>
                    <Button x:Name="WatchButton" Content="Theo dõi thư mục..." Click="WatchButton_Click"/>
                    <Button x:Name="StopButton" Content="Dừng" Click="StopButton_Click" IsEnabled="False"/>
                    <TextBlock x:Name="ProgressText" VerticalAlignment="Center" Foreground="#4B5563"/>
                </WrapPanel>
                <!-- Dòng báo đang theo dõi thư mục nào (ẩn khi không theo dõi) -->
                <TextBlock x:Name="WatchText" DockPanel.Dock="Top" Foreground="#1565C0" FontWeight="SemiBold" Margin="0,0,0,6"
                           Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                <!-- Khung ảnh: nhận kéo thả file hoặc thư mục -->
                <Border Background="#111827" CornerRadius="6" AllowDrop="True" DragOver="DropArea_DragOver" Drop="DropArea_Drop">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="PlaceholderText" Text="Kéo thả ảnh hoặc thư mục vào đây" Foreground="#9CA3AF" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        <Border x:Name="ImageNameBox" Background="#99000000" CornerRadius="3" Padding="8,3" Margin="10"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
                            <TextBlock x:Name="ImageNameText" Foreground="#F9FAFB"/>
                        </Border>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- Bên phải: kết luận lớn, chi tiết, thống kê -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Kết luận lớn: OK xanh, NG đỏ, HOLD cam -->
                    <Border x:Name="ResultBanner" Background="#9CA3AF" CornerRadius="6" Padding="10" MinHeight="150">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ResultText" Text="—" FontSize="80" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ResultSubText" Text="Chưa kiểm tra" FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Thống kê từ lúc mở chương trình (hoặc từ lần xóa lịch sử gần nhất) -->
                    <Border Background="#F3F4F6" CornerRadius="6" Padding="8,8" Margin="0,10,0,0">
                        <UniformGrid Columns="5">
                            <StackPanel>
                                <TextBlock x:Name="TotalCountText" Text="0" Style="{StaticResource CountText}"/>
                                <TextBlock Text="Tổng" Style="{StaticResource CountLabel}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="OkCountText" Text="0" Style="{StaticResource CountText}" Foreground="#2E7D32"/>
                                <TextBlock Text="OK" Style="{StaticResource CountLabel}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="NgCountText" Text="0" Style="{StaticResource CountText}" Foreground="#C62828"/>
                                <TextBlock Text="NG" Style="{StaticResource CountLabel}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="HoldCountText" Text="0" Style="{StaticResource CountText}" Foreground="#EF6C00"/>
                                <TextBlock Text="HOLD" Style="{StaticResource CountLabel}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="NgRateText" Text="0%" Style="{StaticResource CountText}"/>
                                <TextBlock Text="Tỉ lệ NG" Style="{StaticResource CountLabel}"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <!-- Thanh xác suất NG -->
                    <TextBlock Text="Xác suất NG" Style="{StaticResource LabelText}" Margin="0,12,0,4"/>
                    <Grid>
                        <ProgressBar x:Name="PNgBar" Height="24" Minimum="0" Maximum="1" Value="0" Foreground="#E57373" Background="#F3F4F6"/>
                        <TextBlock x:Name="PNgValueText" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Bảng chi tiết -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Xác suất từng lớp" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ProbabilitiesText" Style="{StaticResource ValueText}"/>
                        <TextBlock Grid.Row="1" Text="Thời gian service" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ServiceMsText" Style="{StaticResource ValueText}"/>
                        <TextBlock Grid.Row="2" Text="Thời gian khứ hồi" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RoundTripText" Style="{StaticResource ValueText}"/>
                        <TextBlock Grid.Row="3" Text="Ngưỡng NG" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ThresholdText" Style="{StaticResource ValueText}"/>
                        <TextBlock Grid.Row="4" Text="Mô hình" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="VersionText" Style="{StaticResource ValueText}"/>
                        <TextBlock Grid.Row="5" Text="Request ID" Style="{StaticResource LabelText}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="RequestIdText" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" FontWeight="SemiBold" Margin="0,3,0,3" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="6" Text="Ghi chú" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="ErrorText" Style="{StaticResource ValueText}" Foreground="#C62828"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
